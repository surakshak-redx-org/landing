# Live location tracking page (/track/<token>). Copy to .env.local and fill in.
# Both are NEXT_PUBLIC_*, so they are visible in the browser by design. Never put secrets here.

# URL of the liveTrack Cloud Function. The page calls GET <url>?t=<token>.
# Leave empty to see the "not available" state. In `next dev`, the token
# 00000000000000000000000000000000 serves a simulated sender without this.
NEXT_PUBLIC_TRACKING_API_URL=

# Google Maps JavaScript API key for the web. Create a dedicated key in GCP, restricted by
# HTTP referrer to the landing domain(s) and to the Maps JavaScript API only.
# Never reuse the app's Android/iOS keys.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY_WEB=
